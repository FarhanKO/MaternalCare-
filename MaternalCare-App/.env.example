# Where the app's server is. Compiled into the APK by `npm run apk`, so the
# app connects on its own and nobody types an address on the phone.
#
#   a laptop running `npm start` on the same wifi (find the address with
#   `ipconfig` — the Wi-Fi adapter's IPv4):
API_URL=http://192.168.0.249:3000/api
#
#   the deployed site, once it is up (then build again and reinstall):
# API_URL=https://maternalcare.onrender.com/api

# The web project, when it is not beside this folder.
# WEBAPP_DIR=../MaternalCare-Webapp
