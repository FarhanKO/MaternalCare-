# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------- database
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the SESSION POOLER (port 5432). The direct connection is IPv6-only on
# the free tier, and the transaction pooler (6543) drops prepared statements.
DATABASE_URL=

# ------------------------------------------------------------------ server
PORT=3000

# Comma-separated browser origins allowed to call /api from another origin
# (CORS) and to make requests that change things (CSRF). Leave unset in
# development and the two Vite dev ports plus private-network addresses on
# those ports are accepted. In production an unset value means *no* other
# origin: the built client is served by this process, on the same origin,
# and needs neither. Set it only for a split deployment.
# CLIENT_ORIGIN=https://app.example.org

# ------------------------------------------------------------ production
# Setting this turns on everything that only makes sense behind https:
#   - plain-http requests are redirected (GET) or refused (anything else)
#   - the session cookie becomes Secure and takes the __Host- prefix
#   - Strict-Transport-Security is sent, for a year
#   - the demo-accounts list on the sign-in screen is switched off
#   - CORS trusts only CLIENT_ORIGIN (see above)
# A deployment that cannot offer https should not set it.
# NODE_ENV=production

# How many proxies sit between the internet and this process. Behind Render,
# Heroku, nginx or one load balancer the answer is 1 (the default in
# production): their X-Forwarded-Proto and X-Forwarded-For are believed, so
# TLS enforcement and the sign-in rate limiter see the real scheme and
# address. 0 when this process terminates TLS itself (TLS_*_FILE below).
# Too high a number believes whatever a client writes in those headers.
# TRUST_PROXY=1

# --------------------------------------------------- push notifications
# The key pair that signs reminder notifications sent to browsers. Make one
# once with `npx web-push generate-vapid-keys` and keep it: every device's
# subscription is bound to the public key, so a new pair silently
# unsubscribes everyone. Unset, a pair is generated on first boot and kept
# in data/vapid.json — fine for development, not for a deployment that may
# be rebuilt. VAPID_SUBJECT is who a push service may contact about abuse.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@maternalcare.app

# Terminate TLS in this process instead of a proxy: PEM files, and the
# server listens for https on PORT. Leave unset behind a proxy.
# TLS_KEY_FILE=/etc/ssl/private/maternalcare.key
# TLS_CERT_FILE=/etc/ssl/certs/maternalcare.crt

# ------------------------------------------------- risk model service (F13)
# The FastAPI classifier in ml-service/. Optional: the app falls back to the
# rule engine when this is unreachable, so leaving it unset is fine.
ML_SERVICE_URL=http://localhost:8000
# How long to wait before giving up on it, in milliseconds.
ML_TIMEOUT_MS=2500

# ------------------------------------------------------------------- voice
# Speech-to-text for the symptom logger. Optional: with no key the app falls
# back to the browser's own SpeechRecognition, which works in Chrome and Edge
# and understands English well but Bangla poorly.
#
# Any OpenAI-compatible transcription endpoint works. The audio is sent, the
# text comes back, and nothing is stored on either side.
# OPENAI_API_KEY=sk-...
#
# To point at a different provider or a self-hosted Whisper:
# VOICE_API_URL=https://api.openai.com/v1/audio/transcriptions
# VOICE_MODEL=whisper-1
# VOICE_TIMEOUT_MS=30000
