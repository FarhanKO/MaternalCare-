<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen widget. Only what RemoteViews can draw: linear layouts,
    text and images. Which rows are visible is decided in MaternalCareWidget
    from the size she gave it and what she switched on in the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical">

    <!-- this week -->
    <LinearLayout
        android:id="@+id/row_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_brand_dot"
            android:padding="4dp"
            android:src="@drawable/ic_w_activity"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/week_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Week 31 · third trimester" />

        <TextView
            android:id="@+id/week_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_soft"
            android:textSize="12sp"
            android:text="57 days to go" />
    </LinearLayout>

    <TextView
        android:id="@+id/baby_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_soft"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Butternut squash · 39.9 cm · 1.3 kg" />

    <!-- the small message; tapping it shows the next one -->
    <LinearLayout
        android:id="@+id/row_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_pill"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/message_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_w_heart"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/message_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Don’t forget to drink water — a glass now is an easy win." />
    </LinearLayout>

    <!-- the next reminder -->
    <LinearLayout
        android:id="@+id/row_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:paddingLeft="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_w_bell"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/reminder_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:textColor="@color/widget_soft"
            android:textSize="12.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Iron tablet · Today 9:00 PM" />
    </LinearLayout>

    <!-- the reading for this week -->
    <LinearLayout
        android:id="@+id/row_reading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:paddingLeft="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_w_book"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/reading_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:textColor="@color/widget_soft"
            android:textSize="12.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Side-sleeping from 28 weeks · 4 min" />
    </LinearLayout>

    <!-- before the app has been opened on this phone -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/widget_soft"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="@string/widget_empty" />
</LinearLayout>
